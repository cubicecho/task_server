{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": { "enabled": false, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "web/**",
      "server/**",
      "shared/**",
      "tests/**",
      "scripts/**",
      "*.ts",
      "*.json",
      "!web/__generated__",
      "!.claude"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useConst": "error",
        "noNonNullAssertion": "error",
        "useBlockStatements": "error"
      },
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  },
  "javascript": {
    "formatter": { "quoteStyle": "double", "trailingCommas": "all" }
  },
  "css": {
    "parser": { "tailwindDirectives": true }
  },
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } },
  "overrides": [
    {
      "includes": ["web/components/ui/**"],
      "linter": { "enabled": false }
    },
    {
      "includes": [
        "web/components/action-button.tsx",
        "web/components/app-form.tsx",
        "web/components/card-layout.tsx",
        "web/components/confirm-button.tsx",
        "web/components/dialog-layout.tsx",
        "web/components/disclosure-row.tsx",
        "web/components/field-row.tsx",
        "web/components/form-field.tsx",
        "web/components/header-content-footer.tsx",
        "web/components/multi-select-field.tsx",
        "web/components/multi-select.tsx",
        "web/components/option-select.tsx",
        "web/components/page-header.tsx",
        "web/components/page-layout.tsx",
        "web/components/password-field.tsx",
        "web/components/password-input.tsx",
        "web/components/query-state.tsx",
        "web/components/radio-group-field.tsx",
        "web/components/section.tsx",
        "web/components/split-layout.tsx"
      ],
      "linter": { "rules": { "style": { "useBlockStatements": "off" } } }
    }
  ]
}
