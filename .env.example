# Fallback for the API key; the value saved in Settings wins if both are set.
OPENAI_API_KEY=
# Express port (the Vite dev server proxies /graphql here; agents reach /mcp directly).
PORT=8787
# Where the tasks live. A file: path (or a bare path) uses the built-in SQLite; a postgres://
# URL switches the tables, the driver and the boot-time DDL over to postgres. Nothing else
# changes — see server/db/client.ts.
DATABASE_URL=file:./data/tasks.db
# DATABASE_URL=postgres://tasks:tasks@localhost:5432/tasks
