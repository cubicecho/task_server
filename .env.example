# Fallback for the API key; the value saved in Settings wins if both are set.
OPENAI_API_KEY=
# Express port (the Vite dev server proxies /graphql here; agents reach /mcp directly).
PORT=8787
# Where the tasks live. Left empty, the server runs postgres itself (PGlite) against ./data.
# A postgres:// URL points it at a postgres server instead; nothing else changes — see
# server/db/client.ts.
DATABASE_URL=
# DATABASE_URL=postgres://tasks:tasks@localhost:5432/tasks
