{
  "name": "task-server",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "npm run typecheck && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "schema": "tsx scripts/print-schema.ts",
    "codegen": "npm run schema && graphql-codegen",
    "pretypecheck": "npm run codegen",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "pretest": "npm run codegen",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@casl/ability": "^7.0.1",
    "@cubicecho/agent-core": "^4.0.0",
    "@cubicecho/agent-mcp-pool": "^3.7.0",
    "@cubicecho/graphql-mcp": "^3.0.0",
    "@electric-sql/pglite": "^0.5.8",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/pg": "^8.23.1",
    "@vantreeseba/drizzle-graphql": "^13.0.0",
    "@vantreeseba/graphql-casl": "^1.10.0",
    "drizzle-orm": "1.0.0-rc.4",
    "express": "^5.2.1",
    "graphql": "^16.11.0",
    "graphql-middleware": "^6.1.35",
    "graphql-scalars": "^2.0.0",
    "graphql-yoga": "^5.24.4",
    "node-cron": "^4.6.0",
    "openai": "^7.30.1",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cubicecho/graphql-codegen-field-descriptions": "^1.0.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@graphql-codegen/cli": "^7.4.5",
    "@graphql-codegen/typed-document-node": "^7.1.1",
    "@graphql-codegen/typescript": "^6.1.1",
    "@graphql-codegen/typescript-operations": "^6.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "concurrently": "^10.0.6",
    "drizzle-kit": "1.0.0-rc.4",
    "lucide-react": "^1.53.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-graphql-codegen": "^4.0.1",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
